# The game master's settings on the Pi, read by both systemd units.
# install.sh copies this to /etc/gamemaster/gamemaster.env (mode 600) once; edit it there.

# --- the gateway (stackchan-mcp 0.18.0) ---------------------------------------------
# The address the StackChan uses to upload photos and fetch avatar sets: the Pi on its
# own hotspot (pi/hotspot.sh). Must be set before the robot connects; after a change,
# restart the gateway and let the robot reconnect.
VISION_HOST=10.42.0.1
WS_PORT=8765
CAPTURE_PORT=8766
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8767
# English speech recognition (the brain always asks for language "en").
STACKCHAN_FASTER_WHISPER_MODEL=base.en
STACKCHAN_FASTER_WHISPER_DEVICE=cpu
STACKCHAN_FASTER_WHISPER_COMPUTE_TYPE=int8
# A shared secret for the robot's connection, /mcp and /pcm. Leave it unset on the
# private hotspot unless the robot was provisioned with the same token
# (gateway_config_set); when set, the brain needs it too (GM_BRAIN_ARGS --token).
#STACKCHAN_TOKEN=

# --- the brain ----------------------------------------------------------------------
# Extra flags for `python -m brain` (gamemaster-brain.service adds --gateway, --pcm,
# --voice-dir and --piper-model). For example a 30-second day for a table demo, or a
# reversed head:  GM_BRAIN_ARGS=--day-seconds 30 --flip-yaw
GM_BRAIN_ARGS=
